# =============================================================================
# pcloudcc Docker - Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.sample .env
# =============================================================================

# --- Required ---
# pCloud account email address
PCLOUD_USER=your@email.com

# --- Authentication (optional) ---
# Account password — only needed for automatic first-time login. Once
# /root/.pcloud/data.db has been created, this can be removed again.
#PCLOUD_PASSWORD=

# Alternative: path to a file containing the account password (Docker secret).
#PCLOUD_PASSWORD_FILE=

# TOTP shared secret (base32, as shown by your authenticator when you set
# up 2FA — usually labeled "secret key" or "manual entry key"). If set,
# fresh 6-digit codes are generated automatically with oathtool, so the
# first-time login no longer depends on a manually entered one-shot code.
#PCLOUD_TOTP_SECRET=

# Alternative: path to a file containing the TOTP secret (Docker secret).
#PCLOUD_TOTP_SECRET_FILE=

# Single-use 2FA code (alternative to PCLOUD_TOTP_SECRET). Only useful for
# a single first-time login — codes expire after ~30 seconds, so prefer
# PCLOUD_TOTP_SECRET for unattended setups.
#PCLOUD_2FA=

# Crypto folder password (leave empty to skip crypto unlock)
#PCLOUD_CRYPT=

# Alternative: path to a file containing the crypto password.
# Use this instead of PCLOUD_CRYPT to avoid exposing the password in the
# environment (e.g. with Docker secrets: /run/secrets/pcloud_crypt).
#PCLOUD_CRYPT_FILE=

# --- Mount settings (optional) ---
# Where pcloudcc mounts the pCloud filesystem inside the container. This is the
# path docker-compose.yml bind-mounts to the host, so it is the one setting that
# decides where your files show up (default: /pcloud_internal, overridden to
# /pcloud in the shipped compose file).
#PCLOUD_MOUNT=/pcloud

# Owner name/group for the mount point (default: nobody/users). Applied with
# chown before pcloudcc mounts over it.
#USER=nobody
#GROUP=users

# --- Bindfs settings (deprecated, kept for compatibility) ---
# bindfs was removed from the image. It ran a second FUSE process on top of
# pcloudcc's mount purely to rewrite file ownership, and it is packaged only in
# Debian/Ubuntu (Alpine has it in edge/testing only), which tied the image to
# a Debian base.
#
# The four variables below are still accepted so existing setups keep starting.
# ENABLE_BINDFS=1 now makes pcloudcc mount directly at BINDFS_TARGET — the path
# your volume mapping expects stays exactly where it was — and logs a warning.
# UID/GID no longer have any effect; see PCLOUD_FUSE_OPTS at the bottom for the
# remaining way to influence reported ownership.
#
# For new setups, drop these and set PCLOUD_MOUNT above instead.
#ENABLE_BINDFS=1
#BINDFS_TARGET=/pcloud
#UID=1000
#GID=1000

# --- Timeouts (optional) ---
# Seconds to wait for a mount to become ready (default: 60).
# Raise this on slow ARM devices or high-latency links if startup logs
# show a mount-timeout warning.
#MOUNT_TIMEOUT=60

# --- pcloudcc tuning (optional) ---
# All three are passed straight through to pcloudcc and are unset by default,
# which leaves pcloudcc's own defaults in place. They require an upstream build
# from 2026-05 or newer; with an older PCLOUDCC_REF the flags do not exist and
# the daemon refuses to start.

# Local cache limit in GB (pcloudcc default: 5). The cache lives in
# /root/.pcloud, i.e. inside the `pconfig` volume — lower this if that volume
# sits on a small system partition.
#PCLOUD_CACHE_SIZE=5

# Verbosity of pcloudcc's own log at /root/.pcloud/debug.log, also inside the
# `pconfig` volume and NOT covered by the `logging:` limits in
# docker-compose.yml (those only cap Docker's capture of stdout/stderr).
# One of NONE, ERROR, WARNING, INFO (pcloudcc default), NOTICE, DEBUG.
#PCLOUD_LOG_LEVEL=ERROR

# Extra FUSE mount options, comma-separated. `uid=`/`gid=` ask pcloudcc to
# report the ownership you want directly and are the only remaining substitute
# for the removed bindfs remapping. Whether they are accepted depends on the
# libfuse/kernel combination — if the mount fails to come up, unset this again.
#PCLOUD_FUSE_OPTS=uid=1000,gid=1000
